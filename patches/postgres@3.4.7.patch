diff --git a/cf/src/index.js b/cf/src/index.js
index 3ffb7e65a477928e543617dad15201c4ed656bf3..3a93365651730898e586fff0603d47c147e26598 100644
--- a/cf/src/index.js
+++ b/cf/src/index.js
@@ -212,20 +212,29 @@ function Postgres(a, b) {
       })
 
     move(c, reserved)
-    c.reserved = () => queue.length
+    const owner = c.reserved = () => queue.length
       ? c.execute(queue.shift())
       : move(c, reserved)
     c.reserved.release = true
+    // When the connection closes, onclose clears c.reserved and can hand c to a
+    // queued reserve(). This reservation is then over: its queued and later
+    // queries fail, and its release() leaves c to the new owner.
+    c.onclose = e => { while (queue.length) queue.shift().reject(e) }
 
     const sql = Sql(handler)
     sql.release = () => {
+      if (c.reserved !== owner)
+        return
       c.reserved = null
+      c.onclose = null
       onopen(c)
     }
 
     return sql
 
     function handler(q) {
+      if (c.reserved !== owner)
+        return q.reject(Errors.connection('CONNECTION_CLOSED', options))
       c.queue === full
         ? queue.push(q)
         : c.execute(q) || move(c, full)
@@ -424,7 +433,10 @@ function Postgres(a, b) {
     c.reserved = null
     c.onclose && (c.onclose(e), c.onclose = null)
     options.onclose && options.onclose(c.id)
-    queries.length && connect(c, queries.shift())
+    // A queued reserve() stays in queries, as reserve() itself leaves it, for
+    // onopen to resolve. Shifted out, it was dropped as the reconnect's initial
+    // and never settled (porsager/postgres#1195).
+    queries.length && connect(c, queries.peek().reserve ? queries.peek() : queries.shift())
   }
 }
 
