diff --git a/cf/src/index.js b/cf/src/index.js
index 3ffb7e65a477928e543617dad15201c4ed656bf3..7685627820ba5f513e1dba7a15cc1b8a150487f6 100644
--- a/cf/src/index.js
+++ b/cf/src/index.js
@@ -424,7 +424,10 @@ function Postgres(a, b) {
     c.reserved = null
     c.onclose && (c.onclose(e), c.onclose = null)
     options.onclose && options.onclose(c.id)
-    queries.length && connect(c, queries.shift())
+    // A queued reserve() stays in queries, as reserve() itself leaves it, for
+    // onopen to resolve. Shifted out, it was dropped as the reconnect's initial
+    // and never settled (porsager/postgres#1195).
+    queries.length && connect(c, queries.peek().reserve ? queries.peek() : queries.shift())
   }
 }
 
