# ---------- Stage 1: Build the Immich Web SPA ----------
FROM node:22.16.0-alpine3.20@sha256:2289fb1fba0f4633b08ec47b94a89c7e20b829fc5679f9b7b298eaa2f1ed8b7e AS web

ARG APP_ID
ENV APP_ID=$APP_ID

WORKDIR /usr/src/app

# Copy only needed files to keep build context small
COPY ./web ./web/
COPY ./i18n ./i18n/
COPY ./open-api/typescript-sdk ./open-api/typescript-sdk/

# Build the TypeScript SDK
WORKDIR /usr/src/app/open-api/typescript-sdk
RUN npm ci && npm run build

# Build the SvelteKit SPA
WORKDIR /usr/src/app/web
RUN npm ci && node ./custom-build.js && npm run build


# ---------- Stage 2: Serve the built SPA with NGINX ----------
FROM nginx:alpine AS web-prod

# Debug: Show current working directory and list files
RUN pwd
RUN ls -la /

# Copy built static files from previous stage
COPY --from=web /usr/src/app/web/build /usr/share/nginx/html

# Custom NGINX config to support SPA routing
COPY ./docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080